# Личный ассистент — пример окружения.
# Реальные значения живут в /etc/assistant.env и /etc/assistant-telegram.env
# (права 600) и в репозиторий не попадают.

# --- ядро (/etc/assistant.env) ------------------------------------------
ASSISTANT_DB=/opt/assistant/assistant.db
TZ_NAME=Europe/Moscow

# доступ к API и панели (/ui). Пусто — открыто всем в сети: внутри личная
# переписка, так что задайте длинную случайную строку. С 127.0.0.1 токен не
# спрашивается, поэтому бот и tg-user менять не нужно.
ASSISTANT_WEB_TOKEN=

# владелец и персона
OWNER_NAME=
OWNER_GENDER=male                 # male | female — род в черновиках ответов
ASSISTANT_NAME=Джарвис
ASSISTANT_GENDER=female           # род, в котором ассистент говорит о себе

# модели
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GATEWAY_URL=http://127.0.0.1:8791/v1
GATEWAY_KEY=
GATEWAY_MODEL=cursor-grok-4.6-high-fast
LLM_DEFAULT_PROVIDER=local        # local | cursor
LLM_PRIVATE_PROVIDER=local        # личные данные не уходят наружу
LLM_TIMEOUT=300
WHISPER_MODEL=small               # распознавание речи; синтеза речи нет

# почта: письма попадают в те же входящие, что и сообщения Telegram.
# Пароль — приложения, не от аккаунта. Пресеты портов: yandex, gmail,
# mailru, icloud; для своего сервера задайте MAIL_<ИМЯ>_IMAP_HOST и SMTP_HOST.
MAIL_ACCOUNTS=                    # пусто — почта выключена; пример: yandex,gmail
MAIL_YANDEX_USER=
MAIL_YANDEX_PASSWORD=
MAIL_YANDEX_FROM_NAME=
# MAIL_<ИМЯ>_SMTP_SSL: по умолчанию implicit TLS везде, кроме порта 587
# (STARTTLS). Задаётся явно, если на своём сервере порт нестандартный.
MAIL_FOLDER=INBOX
MAIL_POLL_SECONDS=120
MAIL_MAX_PER_POLL=10              # писем за один заход
MAIL_MAX_AGE_HOURS=72             # старое непрочитанное не поднимаем
MAIL_MAX_BODY_CHARS=4000
MAIL_IGNORE_SENDERS=              # домены и адреса, которые не нужны совсем
# Отбор роботов не безошибочен: кого отсеяли, видно в «Настройках», там же
# отправителя можно вернуть или заглушить — это решение хранится в базе.

# календарь по CalDAV: расписание попадает в ответы, подсказки и напоминания.
# Пароль — приложения. Адрес сервера подставляется по имени: yandex, icloud,
# mailru, google; для своего сервера задайте CALDAV_<ИМЯ>_URL.
CALDAV_ACCOUNTS=                  # пусто — календарь выключен; пример: yandex
CALDAV_YANDEX_USER=
CALDAV_YANDEX_PASSWORD=
CALENDAR_HORIZON_DAYS=14          # насколько вперёд держать расписание
CALENDAR_CONTEXT_EVENTS=5         # сколько встреч подмешивать в ответ
CALENDAR_REFRESH_SECONDS=600
CALENDAR_REMIND_MINUTES=60,10     # за сколько минут предупреждать о встрече

# действия и разрешения
RESPONSE_MODE=SUGGEST_ONLY        # ассистент предлагает, отправляет владелец
TRUSTED_PEERS=                    # id, которым можно писать без подтверждения
ACTION_APPROVAL_TTL=600           # секунд на подтверждение
ACTION_MAX_ATTEMPTS=3
ACTION_RETRY_BACKOFF=2.0

# уведомления
NOTIFY_QUIET_FROM=23              # часы тишины: только критичное
NOTIFY_QUIET_TO=8
NOTIFY_MIN_INTERVAL=30            # секунд между уведомлениями из одного источника

# память
MEMORY_MIN_CONFIDENCE=0.45
MEMORY_INFERENCE_CAP=0.6          # потолок доверия к выводам модели
MEMORY_DEDUPE_THRESHOLD=0.62
MEMORY_RETRIEVAL_LIMIT=8
EVENT_RETENTION_DAYS=30

# внешние сервисы
FINANCE_API=http://127.0.0.1/api/v1
TG_USER_URL=http://127.0.0.1:8810
EXT_PROXY=
WEATHER_LAT=55.75
WEATHER_LON=37.62
WEATHER_PLACE=Москва
TRADING_CHANNEL=

# новости
NEWS_FEEDS=
NEWS_CACHE_TTL=300
NEWS_SKIP_CATEGORIES=
NEWS_JUNK_EXTRA=
NEWS_DIRECT_TIMEOUT=6
NEWS_PROXY_TIMEOUT=12

# --- Telegram-бот (/etc/assistant-telegram.env) -------------------------
TG_TOKEN=
TG_ALLOWED_ID=                    # только этот пользователь обслуживается
TG_PROXY=http://127.0.0.1:8080    # доступ к api.telegram.org
ASSISTANT_URL=http://127.0.0.1:8800
BRIEFING_TIME=08:30
EVENING_BRIEFING_TIME=            # пусто — вечерний брифинг только по команде
TG_NEWS_LIMIT=12
TG_NOTIFY_POLL=5                  # секунд между опросами очереди уведомлений

# --- аккаунт владельца, tg-user (/etc/tg-user.env) ----------------------
TG_API_ID=
TG_API_HASH=
TG_PHONE=
NOTIFY=1                          # пушить входящие в ядро
NOTIFY_GROUPS=0                   # группы и каналы игнорируются
NOTIFY_COOLDOWN=120               # секунд между пушами из одного чата
