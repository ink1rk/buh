[Unit]
Description=Personal Finance AI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/personal-finance-ai/backend
EnvironmentFile=/opt/personal-finance-ai/.env
Environment=PYTHONPATH=/opt/personal-finance-ai/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/personal-finance-ai/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
