[Unit]
Description=Стол Hermes: почта, календарь и ядро ассистента
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cursor
Group=cursor
WorkingDirectory=/opt/assistant/assistant
Environment=PYTHONPATH=/opt/assistant/assistant
EnvironmentFile=/etc/assistant.env
ExecStart=/opt/assistant/.venv/bin/python -m uvicorn assistant:app --host 127.0.0.1 --port 8800
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
