# Скопировать в $HERMES_HOME/.env

# модель Hermes задаётся `hermes model`, ключ провайдера — сюда
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# бот Hermes. Чужие чаты не собираем — это канал владельца.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Если api.telegram.org с машины недоступен:
# TELEGRAM_PROXY=http://127.0.0.1:8080

OBSIDIAN_VAULT_PATH=/opt/assistant/hermes/vault
ASSISTANT_URL=http://127.0.0.1:8800
TG_USER_URL=http://127.0.0.1:8810
