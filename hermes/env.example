# Скопировать в $HERMES_HOME/.env

# Ключ локального шлюза. Имя переменной совпадает с model.key_env.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:8791/v1
# Чат, куда слать итоги заданий. Для лички это id владельца.
# TELEGRAM_HOME_CHANNEL=

# Голос по умолчанию — Edge, ключ не нужен. Голос: ru-RU-DmitryNeural.
# EDGE_TTS_VOICE=ru-RU-DmitryNeural
# Запасной синтез, если понадобится ElevenLabs:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# бот Hermes. Чужие чаты не собираем — это канал владельца.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Внешний HTTP. Локалка и своя подсеть — напрямую.
HTTP_PROXY=http://172.20.20.231:8080
HTTPS_PROXY=http://172.20.20.231:8080
NO_PROXY=localhost,127.0.0.1,::1,172.20.20.0/24,10.0.0.0/8,192.168.0.0/16,.lan
# Bot API (HTTPS). MTProto личного аккаунта — SOCKS5 172.20.20.231:1080.
TELEGRAM_PROXY=http://172.20.20.231:8080

OBSIDIAN_VAULT_PATH=/opt/assistant/hermes/vault
ASSISTANT_URL=http://127.0.0.1:8800
TG_USER_URL=http://127.0.0.1:8810
