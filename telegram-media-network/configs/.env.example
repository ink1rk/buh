# COPY ONLY FOR LOCAL DEV / STAGING. NEVER COMMIT REAL VALUES.
ENVIRONMENT=development
DRY_RUN=true
PUBLISH_ENABLED=false
GLOBAL_KILL_SWITCH=true
SPONSORED_ENABLED=false
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8787
APP_TIMEZONE=Europe/Moscow
DATABASE_URL=postgresql+psycopg://tmn_app:CHANGE_ME@db:5432/tmn
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHARS
GITHUB_READ_TOKEN=
HF_READ_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
SOURCE_MODE=offline
PILOT_MODE=offline_replay
LLM_MODE=mock
# Host root only. The client appends LLM_API_PATH. A loopback host is the default allowlist.
# Live Ollama is not started by this build. LLM_MODE=local still requires an injected client.
LLM_BASE_URL=
LLM_API_PATH=/api/chat
LLM_ALLOWED_HOSTS=127.0.0.1,localhost,::1
LLM_MODEL=
MEDIA_REMOTE_SCREENSHOT_ENABLED=false
