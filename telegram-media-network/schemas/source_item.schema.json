{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tmn/schemas/source_item.schema.json",
  "title": "NormalizedSourceItem",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_external_id", "source_url", "title", "discovered_at", "published_at", "raw_sha256", "license_state", "facts"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "source_external_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "title": {"type": "string", "minLength": 4, "maxLength": 400},
    "discovered_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "raw_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "content_kind": {"enum": ["repo", "release", "news", "research", "advisory", "package"]},
    "language": {"type": ["string", "null"]},
    "license_state": {"enum": ["explicit_open_source", "explicit_non_oss", "unknown", "not_applicable"]},
    "license_spdx": {"type": ["string", "null"]},
    "is_preprint": {"type": "boolean"},
    "facts": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "statement", "evidence_url", "evidence_excerpt"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 3, "maxLength": 400},
          "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "evidence_excerpt": {"type": "string", "maxLength": 160}
        }
      }
    }
  }
}
