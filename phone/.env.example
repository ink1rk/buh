# Мост с телефоном — пример окружения.
# Реальные значения живут в /etc/assistant-phone.env (права 600).

PHONE_DB=/opt/assistant/phone.db
# 127.0.0.1 — мост виден только самой машине, и телефон до него не дойдёт.
# 0.0.0.0 — виден в домашней сети: так работают ярлыки iOS. В интернет
# порт не пробрасывать: здоровье и геопозиция поехали бы открытым HTTP.
PHONE_HOST=127.0.0.1
PHONE_PORT=8820
TZ_NAME=Europe/Moscow

# Токен постановки устройства на учёт: с ним ярлык получает свой токен.
# Пусто — устройство поставить нельзя вовсе. Поблажки для локального адреса
# нет: когда мост открыт в домашнюю сеть, токен — единственная защита.
PHONE_ENROLL_TOKEN=

# Токен для клиентов MCP: ядро, Cursor, шлюз. Спрашивается всегда.
PHONE_MCP_TOKEN=

# Браузерные источники, которым разрешён /mcp. Пусто — ни одному:
# защита от DNS rebinding, обычным клиентам Origin не нужен.
PHONE_ALLOWED_ORIGINS=

# Приватность: по умолчанию от переписки остаются только метаданные —
# кто, когда и сколько написал. Текст не сохраняется.
PHONE_STORE_TEXT=0
PHONE_PREVIEW_CHARS=160           # длина превью, если хранение текста включено
PHONE_RETENTION_DAYS=400          # старше — удаляется фоновой уборкой

# Пороги здравого смысла
PHONE_SILENCE_HOURS=6             # столько часов без синхронизации — мост сломан
PHONE_BASELINE_DAYS=14            # по скольким дням считается норма человека
PHONE_REPLY_GRACE_MINUTES=90      # столько молчания — и входящее ждёт ответа
