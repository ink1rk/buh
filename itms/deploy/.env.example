# Скопируйте в .env рядом с docker-compose.yml и задайте свои значения.

# Публичный адрес, по которому открывается интерфейс
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
API_PORT=8000

# База данных
POSTGRES_DB=itms
POSTGRES_USER=itms
POSTGRES_PASSWORD=смените-этот-пароль
POSTGRES_PORT=5433

# Объектное хранилище файлов (MinIO)
S3_BUCKET=itms
S3_ACCESS_KEY=itms
S3_SECRET_KEY=смените-этот-ключ
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Владелец системы создаётся при первом запуске.
# Если пароль не задан, он будет сгенерирован и показан в журнале контейнера api.
OWNER_EMAIL=owner@itms.local
OWNER_PASSWORD=
OWNER_NAME=Владелец системы

# Режим работы и безопасность
ITMS_ENV=prod
# Включите, когда система работает по HTTPS
ITMS_COOKIE_SECURE=false
